			"de.longeyes.LongEyes"
		],
		"client": [
			"de.longeyes.client.LongEyesClient"
		]
	},
	"mixins": [
		{
			"config": "longeyes.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
